# ─────────────────────────────────────────────────────────────
# UptimeWatch 환경변수 — 복사해서 사용: cp .env.example .env
# 비밀정보(.env)는 Git 에 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스 ──
POSTGRES_DB=uptimewatch
POSTGRES_USER=uptimewatch
POSTGRES_PASSWORD=change-this-strong-db-password

# ── 애플리케이션 ──
ENVIRONMENT=production
# 반드시 긴 임의 문자열로 변경:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# 사용자가 접속하는 주소(이메일 링크·CSRF Origin 검사에 사용)
PUBLIC_BASE_URL=http://localhost:8080
EXTRA_ALLOWED_ORIGINS=http://127.0.0.1:8080
# HTTPS 로 서비스할 때 true (쿠키 Secure 속성)
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
DISPLAY_TIMEZONE=Asia/Seoul

# ── 웹 포트 ──
# HTTPS 프록시(Caddy) 사용 시 127.0.0.1 유지. 직접 외부 공개 시 0.0.0.0
WEB_BIND=127.0.0.1
WEB_PORT=8080
# HTTPS(Caddy, --profile https) 사용 시 도메인
DOMAIN=status.example.com

# ── 검사 정책 / 제한 ──
CHECK_MIN_INTERVAL_SECONDS=60
CHECK_MAX_TIMEOUT_SECONDS=30
CHECK_MAX_RESPONSE_BYTES=1048576
CHECK_MAX_REDIRECTS=5
CHECK_ALLOWED_PORTS=80,443,8080,8443
CHECK_CONCURRENCY=20
CHECK_PER_HOST_PER_MINUTE=30
MAX_MONITORS_PER_USER=50
MANUAL_CHECK_COOLDOWN_SECONDS=30
CHECK_RETENTION_DAYS=90
# 위험: 사설망 예외(테스트·모의 서버 전용). 운영에서는 비워 두세요.
CHECK_ALLOWED_CIDRS=
# 선택: 외부 송신 프록시(egress proxy). 설정 시 최종 DNS 해석·송신 필터링을 프록시가 담당합니다.
CHECK_EGRESS_PROXY=

# ── 이메일 알림 (SMTP) ──
# SMTP_HOST 와 SMTP_FROM 이 비어 있으면 '미연동' 상태로 표시되고 이메일은 발송되지 않습니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# 587 포트: STARTTLS=true, SSL=false / 465 포트: STARTTLS=false, SSL=true
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_MAX_PER_HOUR_PER_USER=30

# ── 인증 요청 제한 ──
LOGIN_RATE_LIMIT_PER_15MIN=10
REGISTER_RATE_LIMIT_PER_HOUR=5
